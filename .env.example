# ── Sanity (CMS) ─────────────────────────────────────────────
# Create a free project at https://www.sanity.io/manage, then copy its ID here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# API token with "Editor" rights (sanity.io/manage → API → Tokens).
# Used on the server only: saves booking-form enquiries and runs `npm run seed`.
SANITY_API_WRITE_TOKEN=

# ── Site ─────────────────────────────────────────────────────
# Your live address once you have a domain, e.g. https://lumoraglobal.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: email alert for every new enquiry (https://resend.com) ──
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=chiedzamambondiani8@gmail.com
ENQUIRY_FROM_EMAIL=Lumora Website <onboarding@resend.dev>
