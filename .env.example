# ── Staff login (required) ───────────────────────────────────
# A long random secret that signs staff sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The first admin account. Sign in with these once; the account is then saved
# and you can add the rest of the team under "Staff accounts".
ADMIN_NAME=Chiedza
ADMIN_EMAIL=chiedzamambondiani8@gmail.com
ADMIN_PASSWORD=

# ── Content storage ──────────────────────────────────────────
# Leave empty on your computer: content is saved in the .data/ folder.
# On the live site, use Sanity (free): see README, step 2.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: email alert for every new enquiry (https://resend.com) ──
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=chiedzamambondiani8@gmail.com
ENQUIRY_FROM_EMAIL=Lumora Website <onboarding@resend.dev>
